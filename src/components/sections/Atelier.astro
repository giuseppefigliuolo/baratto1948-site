---
/**
 * Gallery. The DOM list is the real content (SEO, no-JS, reduced motion).
 * With motion + WebGL it is swapped for the curved, draggable canvas
 * (src/scripts/gl/atelier.ts), which reuses these same image files.
 */
import { getImage } from 'astro:assets';
import type { Home } from '../../lib/content';
import Img from '../ui/Img.astro';
import Lines from '../ui/Lines.astro';

interface Props { home: Home }
const { home } = Astro.props;
const a = home.atelier;
// Texture sources for the WebGL gallery (panels are ≤ 400 css px wide).
const tex = await Promise.all(a.gallery.map((g) => getImage({ src: g.src, width: 800, format: 'webp', quality: 70 })));
const items = a.gallery.map((g, i) => ({ src: tex[i].src, title: g.alt }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="atelier" aria-labelledby="atelier-title">
  <div class="head">
    <h2 id="atelier-title" class="title" lang="en"><Lines lines={a.title} step={100} /></h2>
    <span class="hint" aria-hidden="true">{a.hint}</span>
  </div>
  <div class="host" data-atelier data-cursor="Trascina" data-items={JSON.stringify(items)}>
    <ul class="list" data-atelier-fallback>
      {a.gallery.map((g) => (
        <li class="media item">
          <Img src={g.src} alt={g.alt} sizes="(max-width: 759px) 64vw, 360px" widths={[480, 768]} />
        </li>
      ))}
    </ul>
  </div>
  <div class="foot">
    <span class="caption" data-atelier-title>{a.gallery[0].alt}</span>
    <span class="count" data-atelier-count>01 / {pad(a.gallery.length)}</span>
  </div>
</section>

<style>
  .atelier { padding: var(--sp-section) 0; border-top: 1px solid rgba(236, 229, 214, 0.1); }
  .head {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px 24px;
    padding: 0 var(--gutter); margin-bottom: clamp(24px, 3vw, 40px);
  }
  .title { max-width: 14em; font: 400 var(--fs-h2)/0.98 var(--serif); }
  .hint { font: 500 var(--fs-micro)/1.4 var(--sans); letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .host { position: relative; height: clamp(340px, 62svh, 900px); }
  .host :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: pan-y; cursor: grab; opacity: 0; transition: opacity 0.8s ease; }
  .list {
    list-style: none; margin: 0;
    display: flex; gap: 12px; height: 100%;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding: 0 var(--gutter);
  }
  .list::-webkit-scrollbar { display: none; }
  .item { flex: none; width: min(64vw, 26svh + 14vw, 560px); height: 100%; scroll-snap-align: center; }
  .foot {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding: clamp(16px, 2vw, 24px) var(--gutter) 0;
  }
  .caption { font: 400 italic var(--fs-quote)/1.2 var(--serif); }
  .count { flex: none; font: 500 var(--fs-micro)/1 var(--sans); letter-spacing: 0.2em; color: var(--gold); }
</style>
