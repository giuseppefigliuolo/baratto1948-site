---
import type { Home, Settings } from '../../lib/content';
import { rich } from '../../lib/rich';
import Img from '../ui/Img.astro';
import mobilePhoto from '../../assets/images/banco-mobile.jpg';

interface Props { home: Home; settings: Settings }
const { home } = Astro.props;
const h = home.hero;
// Portrait phones get a portrait take of the same bench (stamp calibrated in global.css `.hero-frame`).
const HERO_MOBILE = '(max-width: 759px) and (max-aspect-ratio: 1/1)';
---

<section id="top" class="hero" data-cover aria-labelledby="hero-title">
  <div class="inner" data-cover-inner>
    <div class="frame hero-frame" data-seal-frame>
      <Img
        src={h.image.src}
        alt={h.image.alt}
        sizes="(max-aspect-ratio: 1800/1314) 146vh, 100vw"
        widths={[768, 1080, 1440, 1920]}
        art={{ src: mobilePhoto, media: HERO_MOBILE, sizes: '(max-aspect-ratio: 768/1376) 56vh, 100vw' }}
        priority
        class="hero-img"
      />
      <div class="seal-shadow" data-seal-shadow aria-hidden="true"></div>
      <div class="seal-host" data-seal-host></div>
      <div class="seal-hit" data-seal-hit data-cursor="Ruota" aria-hidden="true"></div>
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="content">
      <div class="head">
        <span class="mask"><span class="kicker" data-line style="--d:4200ms">{h.kicker}</span></span>
        <h1 id="hero-title" class="title">
          {h.title.map((line, i) => (
            <span class="mask"><span data-line style={`--d:${4350 + 150 * i}ms`} set:html={rich(line)} /></span>
          ))}
        </h1>
      </div>
      <p class="tagline" data-fade style="--d:4750ms">{h.tagline}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky; top: 0; z-index: 0;
    height: 100vh; height: 100svh; min-height: 560px;
    overflow: hidden; background: #000;
  }
  @media (min-width: 760px) { .hero { height: 100vh; } }
  .inner { position: absolute; inset: 0; overflow: hidden; transform-origin: 50% 100%; }
  :global(.m) .inner { will-change: transform, opacity; }

  /* Geometry and stamp position come from the global `.hero-frame` (shared with the Intro).
     `translate` centres it, `scale` is the Ken Burns (main.ts), both independent of `transform`. */
  :global(.m) .frame { scale: 1.12; }
  .frame :global(.hero-img) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    filter: brightness(0.86);
    pointer-events: none; /* no native image drag: drags belong to the seal */
  }
  /* The canvas host is a square 2.4× the stamp, centred on it: at z=0 the coin covers the print exactly. */
  .seal-host {
    position: absolute; aspect-ratio: 1; pointer-events: none;
    left: calc(var(--sx) - 1.2 * var(--sd)); top: calc(var(--sy) - 1.2 * var(--sd) * var(--ar)); width: calc(2.4 * var(--sd));
  }
  .seal-host :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Grab area over the coin at rest; live only once the seal is on screen (gl/seal.ts).
     `pan-y`: on phones a horizontal swipe spins the coin, a vertical one still scrolls the page. */
  .seal-hit {
    position: absolute; left: var(--sx); top: var(--sy); width: calc(1.2 * var(--sd)); aspect-ratio: 1;
    transform: translate(-50%, -50%); border-radius: 50%;
    pointer-events: none; touch-action: pan-y; user-select: none; -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .seal-hit:global(.is-live) { pointer-events: auto; cursor: grab; }
  .seal-hit:global(.is-grabbing) { cursor: grabbing; }
  .seal-shadow {
    position: absolute; left: var(--sx); top: var(--sy); width: var(--sd); aspect-ratio: 1;
    transform: translate(-50%, -50%); border-radius: 50%; opacity: 0; pointer-events: none;
    background: radial-gradient(closest-side, rgba(20, 12, 6, 0.75) 55%, rgba(20, 12, 6, 0) 100%);
  }

  .shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(110% 85% at 50% 55%, rgba(12, 11, 10, 0) 50%, rgba(12, 11, 10, 0.55) 100%),
      linear-gradient(180deg, rgba(12, 11, 10, 0.6) 0%, rgba(12, 11, 10, 0) 22%, rgba(12, 11, 10, 0) 62%, rgba(12, 11, 10, 0.92) 100%);
  }
  .content {
    position: absolute; left: var(--gutter); right: var(--gutter); bottom: clamp(28px, 3.6vw, 56px);
    display: flex; justify-content: space-between; align-items: flex-end; gap: 24px;
    pointer-events: none;
  }
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 32rem; }
  .head > .mask:first-child { padding: 0 0 0.1em; margin-bottom: -0.1em; }
  .title { font: 400 clamp(2.75rem, min(4.4vw, 7.1svh), 5rem)/1.02 var(--serif); }
  .tagline { margin-bottom: 8px; font: 400 italic var(--fs-quote)/1.3 var(--serif); color: var(--fg-2); }

  @media (max-width: 759px) {
    .shade {
      background:
        radial-gradient(120% 70% at 50% 45%, rgba(12, 11, 10, 0) 45%, rgba(12, 11, 10, 0.5) 100%),
        linear-gradient(180deg, rgba(12, 11, 10, 0.55) 0%, rgba(12, 11, 10, 0) 16%, rgba(12, 11, 10, 0) 64%, rgba(12, 11, 10, 0.94) 86%);
    }
    .content {
      left: 20px; right: 20px; bottom: calc(36px + env(safe-area-inset-bottom));
      flex-direction: column; align-items: stretch; gap: 12px;
    }
    .head { gap: 12px; }
    .kicker { font-size: 11px; }
    .title { font-size: min(44px, 11.3vw); }
    .tagline { margin: 4px 0 0; font-size: 20px; }
  }
</style>
