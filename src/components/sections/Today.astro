---
import type { Home } from '../../lib/content';
import { rich } from '../../lib/rich';

interface Props { home: Home }
const { home } = Astro.props;
const phrases = home.today.phrases;
const last = phrases.length - 1;
---

<section class="today" aria-label="Oggi">
  <p class="text" data-phrases>
    {phrases.map((p, i) => <span data-phrase class:list={{ accent: i === last }} set:html={rich(p)} />)}
  </p>
</section>

<style>
  .today { padding: 0 var(--gutter) var(--sp-section); display: flex; justify-content: center; }
  .text {
    max-width: 24em; text-align: center; text-wrap: balance;
    font: 400 clamp(1.75rem, min(3.4vw, 6.2svh), 4rem)/1.18 var(--serif);
  }
  .accent { color: var(--gold); }
</style>
