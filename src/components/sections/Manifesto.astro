---
import { getImage } from 'astro:assets';
import type { Home } from '../../lib/content';
import { rich } from '../../lib/rich';

interface Props { home: Home }
const { home } = Astro.props;
const m = home.manifesto;
// Decorative, filtered and masked. Crop at build to each frame's ratio so object-fit
// never upscales, and ship a srcset so large/retina screens stay sharp.
const frames = [
  { ratio: 3 / 4, sizes: '(max-width: 759px) 60vw, 28vw' },
  { ratio: 4 / 5, sizes: '(max-width: 759px) 54vw, 26vw' },
  { ratio: 1, sizes: '(max-width: 759px) 46vw, 22vw' }
];
const decor = await Promise.all(m.decor.map((src, i) => {
  const { ratio, sizes } = frames[i];
  const max = Math.min(src.width, Math.floor(src.height * ratio));
  const widths = [400, 640, 960].filter((w) => w <= max);
  const width = widths[widths.length - 1] ?? max;
  return getImage({ src, widths, width, height: Math.round(width / ratio), fit: 'cover', format: 'webp', quality: 60 })
    .then((img) => ({ src: img.src, srcset: img.srcSet.attribute, sizes }));
}));
const last = m.phrases.length - 1;
---

<section class="manifesto" aria-label="Manifesto">
  {decor.map((d, i) => (
    <div class={`decor d${i + 1}`} aria-hidden="true">
      <div class="layer" data-speed={['-0.12', '-0.16', '0.2'][i]}>
        <img src={d.src} srcset={d.srcset} sizes={d.sizes} alt="" loading="lazy" decoding="async" />
      </div>
    </div>
  ))}
  <p class="statement" data-phrases>
    {m.phrases.map((p, i) => <span data-phrase class:list={{ accent: i === last }} set:html={rich(p)} />)}
  </p>
  <span class="rule" aria-hidden="true"></span>
  <p class="body-copy text" data-fade>{m.body} <span class="hl">{m.bodyAccent}</span></p>
</section>

<style>
  /* Mobile first: a tall stage so the three frames sit apart (top-left, mid-right,
     bottom-left) instead of piling up behind the copy. */
  .manifesto {
    position: relative;
    min-height: 118svh;
    padding: calc(var(--sp-section) * 2) var(--gutter);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    /* The decor bleeds past the side edges; clip only x so d3 can still bleed below. */
    overflow-x: clip;
  }
  .decor { position: absolute; pointer-events: none; }
  .layer {
    position: absolute; inset: 0;
    -webkit-mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 35%, transparent 100%);
  }
  .layer img { width: 100%; height: 100%; object-fit: cover; opacity: 0.4; filter: grayscale(0.7) sepia(0.25) brightness(0.8) contrast(1.05); }
  .d1 { left: -18vw; top: 0; width: 60vw; aspect-ratio: 3 / 4; }
  .d2 { right: -20vw; top: 40%; width: 54vw; aspect-ratio: 4 / 5; }
  .d3 { left: 2vw; bottom: -4%; width: 46vw; aspect-ratio: 1; }
  .d3 .layer { -webkit-mask-image: radial-gradient(closest-side, #000 25%, transparent 100%); mask-image: radial-gradient(closest-side, #000 25%, transparent 100%); }
  .d3 .layer img { opacity: 0.3; filter: grayscale(1) brightness(0.85); }

  .statement {
    position: relative; max-width: 11em; text-align: center;
    font: 400 clamp(2.25rem, min(5.4vw, 10svh), 7rem)/1.04 var(--serif);
    letter-spacing: -0.01em; text-wrap: balance;
  }
  /* The closing line always gets its own row, on every width. */
  .accent { display: block; color: var(--gold); }
  .rule {
    position: relative; display: block; flex: none;
    width: 1px; height: clamp(48px, 7vw, 104px);
    margin: clamp(32px, 4vw, 56px) 0;
    background: linear-gradient(var(--gold), transparent);
  }
  .text { position: relative; max-width: min(var(--measure), 30ch); text-align: center; }
  .hl { color: var(--fg); }

  @media (min-width: 760px) {
    /* One screen: padding small enough that the content never pushes it past 100svh. */
    .manifesto { min-height: 100svh; padding-block: var(--sp-section); }
    .d1 { left: -4vw; top: 4%; width: 28vw; }
    .d2 { right: -5vw; top: 26%; width: 26vw; }
    .d3 { left: 20vw; bottom: -6%; width: 22vw; }
    .text { max-width: var(--measure); }
  }
</style>
