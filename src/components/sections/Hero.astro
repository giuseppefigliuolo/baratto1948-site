---
import type { Home, Settings } from '../../lib/content';
import { rich } from '../../lib/rich';
import Img from '../ui/Img.astro';
import Wordmark from '../ui/Wordmark.astro';

interface Props { home: Home; settings: Settings }
const { home } = Astro.props;
const h = home.hero;
---

<section id="top" class="hero" data-cover aria-labelledby="hero-title">
  <div class="inner" data-cover-inner>
    <div class="host" data-hero-host>
      <Img
        src={h.image.src}
        alt={h.image.alt}
        sizes="100vw"
        widths={[768, 1080, 1440, 1920]}
        priority
        class="hero-img"
      />
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="content">
      <div class="row">
        <div class="head">
          <span class="mask"><span class="kicker" data-line>{h.kicker}</span></span>
          <h1 id="hero-title" class="title">
            {h.title.map((line, i) => (
              <span class="mask"><span data-line style={`--d:${80 * (i + 1)}ms`} set:html={rich(line)} /></span>
            ))}
          </h1>
        </div>
        <p class="tagline" data-fade style="--d:300ms">{h.tagline}</p>
      </div>
      <Wordmark delayStart={120} step={50} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky; top: 0; z-index: 0;
    height: 100vh; height: 100svh; min-height: 560px;
    overflow: hidden; background: #000;
  }
  @media (min-width: 760px) { .hero { height: 100vh; } }
  .inner { position: absolute; inset: 0; overflow: hidden; transform-origin: 50% 100%; }
  :global(.m) .inner { will-change: transform, opacity; }
  .host { position: absolute; inset: 0; overflow: hidden; }
  .host :global(.hero-img) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 40%;
    transform: scale(1.1);
  }
  .host :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .shade {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(12, 11, 10, 0.55) 0%, rgba(12, 11, 10, 0) 28%, rgba(12, 11, 10, 0.1) 55%, rgba(12, 11, 10, 0.94) 100%);
  }
  .content {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 0 var(--gutter) clamp(18px, 3vw, 40px);
    display: flex; flex-direction: column; gap: clamp(14px, 2.4vw, 32px);
    pointer-events: none;
  }
  .row { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px 24px; }
  .head { display: flex; flex-direction: column; gap: 12px; max-width: 32rem; }
  .head > .mask:first-child { padding: 0 0 0.1em; margin-bottom: -0.1em; }
  .title { font: 400 clamp(2.25rem, min(4vw, 7.5svh), 5rem)/1.02 var(--serif); }
  .tagline { font: 400 italic var(--fs-quote)/1.3 var(--serif); color: var(--fg-2); }
  @media (max-width: 759px) { .tagline { display: none; } }
</style>
