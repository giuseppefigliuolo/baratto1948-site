---
import type { Settings } from '../lib/content';
import logo from '../assets/brand/logo.png';

interface Props { settings: Settings }
const { settings: s } = Astro.props;

const menuLinks = [
  ['#radici', 'Radici'],
  ['#processo', 'Processo'],
  ['#giacca', 'Giacca'],
  ['#pantalone', 'Pantalone'],
  ['#tessuti', 'Tessuti'],
  ['#contatti', 'Contatti']
] as const;
---

<div class="progress" data-progress aria-hidden="true"></div>

<header class="hdr">
  <nav class="hdr-nav" aria-label="Sezioni">
    <a href="#giacca">Giacca</a><a href="#pantalone">Pantalone</a><a href="#tessuti">Tessuti</a>
  </nav>
  <a href="#top" class="hdr-logo" aria-label={`${s.brand} — torna all'inizio`}>
    <img src={logo.src} width="58" height="58" alt={`${s.brand} Sartoria Artigianale`} />
  </a>
  <div class="hdr-cta">
    <a href="#contatti" class="pill" data-magnetic>Contatti</a>
  </div>
  <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
    <span data-menu-label>Menu</span>
    <span class="burger-lines" aria-hidden="true"><span></span><span></span></span>
  </button>
</header>

<div class="menu" id="menu" data-menu inert>
  <nav class="menu-nav" aria-label="Menu principale">
    {menuLinks.map(([href, label], i) => (
      <a href={href} data-menu-link style={`--md:${0.25 + i * 0.06}s`}>
        <span class="menu-label">{label}</span>
        <span class="menu-n">0{i + 1}</span>
      </a>
    ))}
  </nav>
  <div class="menu-foot">
    <a class="menu-call" href={`tel:${s.phone}`}>{s.phoneDisplay}</a>
    <div class="menu-links">
      <a href={`mailto:${s.email}`}>{s.email}</a>
      <a href={s.instagram} rel="noopener" target="_blank">Instagram</a>
    </div>
  </div>
</div>

<style>
  .progress {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    height: 1px; background: var(--gold);
    transform-origin: 0 50%; transform: scaleX(0);
  }
  :global(html:not(.m)) .progress { display: none; }

  .hdr {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: clamp(12px, 1.6vw, 16px) var(--gutter);
    mix-blend-mode: difference;
  }
  .hdr-nav {
    flex: 1; display: flex; flex-wrap: wrap; gap: 6px 22px;
    font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.22em; text-transform: uppercase;
  }
  .hdr-logo { display: block; flex: none; }
  .hdr-logo img { width: clamp(46px, 4.4vw, 84px); height: clamp(46px, 4.4vw, 84px); }
  .hdr-cta { flex: 1; display: flex; justify-content: flex-end; }
  .pill {
    display: inline-flex; align-items: center;
    padding: 0.95em 1.8em; border: 1px solid var(--fg); border-radius: 100px;
    font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase;
    transition: background 0.3s, color 0.3s, transform 0.6s var(--ease);
  }
  @media (hover: hover) { .pill:hover { background: var(--fg); color: var(--bg); } }

  .burger {
    display: none; align-items: center; gap: 12px;
    height: 44px; padding: 0 4px; background: none; border: 0; cursor: pointer;
    font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.22em; text-transform: uppercase;
  }
  .burger-lines { display: flex; flex-direction: column; gap: 6px; width: 22px; }
  .burger-lines span { display: block; height: 1px; background: var(--fg); transition: transform 0.5s var(--ease); }
  :global(.menu-open) .burger-lines span:first-child { transform: translateY(3.5px) rotate(45deg); }
  :global(.menu-open) .burger-lines span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: 49;
    display: none; flex-direction: column; justify-content: space-between;
    padding: 96px 20px calc(28px + env(safe-area-inset-bottom));
    background: var(--bg-2);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-io);
    pointer-events: none;
  }
  :global(.menu-open) .menu { clip-path: inset(0 0 0 0); pointer-events: auto; }
  .menu-nav { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .menu-nav a {
    display: flex; align-items: baseline; justify-content: space-between;
    padding: 17px 0; border-bottom: 1px solid var(--line); overflow: hidden;
  }
  .menu-label {
    display: block; font: 400 clamp(2.5rem, min(12vw, 7svh), 4.5rem)/1.05 var(--serif);
    transform: translateY(110%); transition: transform 0.9s var(--ease) 0s;
  }
  :global(.menu-open) .menu-label { transform: none; transition-delay: var(--md); }
  .menu-n { font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.2em; color: var(--gold); }
  .menu-foot { display: flex; flex-direction: column; gap: 14px; }
  .menu-call {
    display: flex; justify-content: center; align-items: center; height: 56px;
    background: var(--gold); color: var(--bg); border-radius: 100px;
    font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.16em; text-transform: uppercase;
  }
  .menu-links { display: flex; justify-content: space-between; gap: 12px; font: var(--w-light) var(--fs-body)/1.4 var(--sans); }
  .menu-links a { color: var(--muted); }

  @media (max-width: 759px) {
    .hdr-nav, .hdr-cta { display: none; }
    .burger { display: flex; }
    .menu { display: flex; }
  }
</style>
