---
import { getImage } from 'astro:assets';
import type { Home, Settings } from '../../lib/content';
import logo from '../../assets/brand/logo.png';
import Lines from '../ui/Lines.astro';

interface Props { home: Home; settings: Settings }
const { home, settings: s } = Astro.props;
const c = home.contact;
// Grayscale + 82% dark overlay: a small, soft image is visually identical.
const bg = await getImage({ src: c.background, width: 1280, format: 'webp', quality: 45 });
const year = new Date().getFullYear();
const web = s.website.replace(/^https?:\/\//, '');
---

<section id="contatti" class="contact" aria-labelledby="contatti-title">
  <div class="bg" aria-hidden="true">
    <img src={bg.src} alt="" loading="lazy" decoding="async" data-speed="0.15" data-zoom="1.25" />
    <div class="veil"></div>
  </div>

  <div class="top">
    <img class="logo" src={logo.src} width="200" height="200" alt="" data-fade />
    <h2 id="contatti-title" class="title"><Lines lines={c.title} step={100} /></h2>
    <p class="loc" data-fade>{c.location}</p>
  </div>

  <div class="bottom">
    <address class="cards">
      <a class="card" href={`tel:${s.phone}`}><span class="k">Telefono</span><span class="v">{s.phoneDisplay}</span></a>
      <a class="card" href={`mailto:${s.email}`}><span class="k">Email</span><span class="v">{s.email}</span></a>
      <a class="card" href={s.website}><span class="k">Web</span><span class="v">{web}</span></a>
      <a class="card" href={s.instagram} rel="noopener" target="_blank"><span class="k">Instagram</span><span class="v">{s.instagramHandle}</span></a>
    </address>
    <footer class="foot">
      <span>© {year} {s.brand} · Sartoria Artigianale{s.vatNumber && ` · P.IVA ${s.vatNumber}`}</span>
      <span lang="en">{c.footerTagline}</span>
    </footer>
  </div>
</section>

<style>
  .contact { position: relative; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
  .bg { position: absolute; inset: 0; overflow: hidden; }
  .bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; filter: grayscale(1); transform: scale(1.25); }
  .veil { position: absolute; inset: 0; background: rgba(12, 11, 10, 0.82); }
  .top {
    position: relative;
    padding: clamp(96px, min(12vw, 20svh), 220px) var(--gutter) 0;
    display: flex; flex-direction: column; align-items: center; gap: clamp(20px, 2.4vw, 28px); text-align: center;
  }
  .logo { width: clamp(120px, min(14vw, 22svh), 260px); height: auto; }
  .title { font: 400 var(--fs-display)/0.92 var(--serif); }
  .loc { font: 400 italic var(--fs-quote)/1.4 var(--serif); color: var(--fg-2); }
  .bottom {
    position: relative;
    padding: clamp(48px, 7vw, 88px) var(--gutter) calc(clamp(20px, 2.4vw, 28px) + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; gap: clamp(24px, 3vw, 32px);
  }
  .cards {
    font-style: normal;
    display: grid; grid-template-columns: 1fr;
    gap: 1px; background: rgba(236, 229, 214, 0.2); border: 1px solid rgba(236, 229, 214, 0.2);
  }
  .card {
    display: flex; flex-direction: column; gap: 10px;
    padding: clamp(18px, 2vw, 24px);
    background: rgba(12, 11, 10, 0.6);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    transition: background 0.3s;
    container-type: inline-size;
  }
  @media (hover: hover) { .card:hover { background: rgba(194, 163, 107, 0.18); color: var(--fg); } }
  .k { font: var(--w-bold) var(--fs-micro)/1 var(--sans); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  /* Capped at 10cqi so the email (~10em in Roboto Thin) stays on one line. */
  .v {
    font: var(--w-thin) min(clamp(1.375rem, min(2.6vw, 4.8svh), 2.75rem), 10cqi)/1.1 var(--sans);
    letter-spacing: -0.01em; overflow-wrap: anywhere;
  }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 12px; font: 400 var(--fs-micro)/1.5 var(--sans); color: var(--muted); }
  @media (min-width: 600px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 759px) { .contact { min-height: 0; } }
</style>
