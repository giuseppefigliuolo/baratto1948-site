---
import { getImage } from 'astro:assets';
import type { Home } from '../../lib/content';
import { rich } from '../../lib/rich';

interface Props { home: Home }
const { home } = Astro.props;
const m = home.manifesto;
// Decorative, heavily filtered and masked: small images are plenty.
const decor = await Promise.all(m.decor.map((src) => getImage({ src, width: 480, format: "webp", quality: 50 })));
const last = m.phrases.length - 1;
---

<section class="manifesto" aria-label="Manifesto">
  <div class="decor d1" aria-hidden="true"><div class="layer" data-speed="-0.15"><img src={decor[0].src} alt="" loading="lazy" decoding="async" /></div></div>
  <div class="decor d2" aria-hidden="true"><div class="layer" data-speed="-0.2"><img src={decor[1].src} alt="" loading="lazy" decoding="async" /></div></div>
  <div class="decor d3" aria-hidden="true"><div class="layer" data-speed="0.4"><img src={decor[2].src} alt="" loading="lazy" decoding="async" /></div></div>
  <p class="statement" data-phrases>
    {m.phrases.map((p, i) => <span data-phrase class:list={{ accent: i === last }} set:html={rich(p)} />)}
  </p>
  <p class="body-copy text" data-fade>{m.body} <span class="hl">{m.bodyAccent}</span></p>
</section>

<style>
  .manifesto {
    position: relative;
    padding: calc(var(--sp-section) * 1.4) var(--gutter);
    display: flex; flex-direction: column; align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }
  .decor { position: absolute; pointer-events: none; }
  .layer {
    position: absolute; inset: 0;
    -webkit-mask-image: radial-gradient(closest-side, #000 25%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 25%, transparent 100%);
  }
  .layer img { width: 100%; height: 100%; object-fit: cover; opacity: 0.42; filter: grayscale(0.7) sepia(0.25) brightness(0.8) contrast(1.05); }
  .d1 { left: -8vw; top: clamp(60px, 8%, 140px); width: clamp(240px, 40vw, 620px); aspect-ratio: 3 / 4; }
  .d2 { right: -10vw; top: clamp(120px, 34%, 420px); width: clamp(220px, 34vw, 540px); aspect-ratio: 4 / 5; }
  .d3 { left: clamp(0px, 14vw, 280px); bottom: -6%; width: clamp(200px, 28vw, 440px); aspect-ratio: 1; }
  .d3 .layer { -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent 100%); mask-image: radial-gradient(closest-side, #000 20%, transparent 100%); }
  .d3 .layer img { opacity: 0.32; filter: grayscale(1) brightness(0.85); }

  .statement {
    position: relative; max-width: 18em; text-align: center;
    font: 400 clamp(2.125rem, min(5.4vw, 10svh), 7rem)/1.04 var(--serif);
    letter-spacing: -0.01em; text-wrap: balance;
  }
  .accent { color: var(--gold); }
  .text { position: relative; max-width: var(--measure); text-align: center; }
  .hl { color: var(--fg); }
</style>
